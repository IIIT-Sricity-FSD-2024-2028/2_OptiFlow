// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. PLATFORM LAYER (Billing, Plans, and Super-Admins)
// ---------------------------------------------------------------------------

model Plan {
  id                        String  @id @default(uuid())
  name                      String
  maxBranches               Int? // null = unlimited
  maxUsers                  Int?
  maxActiveProcessTemplates Int?
  maxComplianceRules        Int?
  auditLogRetentionDays     Int
  allowsIntegrations        Boolean

  subscriptions Subscription[]

  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  billingCycle       BillingCycle       @default(Monthly)
  status             SubscriptionStatus @default(Active)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([planId])
  @@map("subscriptions")
}

enum BillingCycle {
  Monthly
  Annual
}

enum SubscriptionStatus {
  Active
  PastDue
  Cancelled
  Trialing
}

model PlatformAdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  supportAccesses PlatformSupportAccess[]

  @@map("platform_admin_users")
}

model PlatformSupportAccess {
  id          String            @id @default(uuid())
  adminUserId String
  adminUser   PlatformAdminUser @relation(fields: [adminUserId], references: [id])
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  reason      String
  grantedAt   DateTime          @default(now())
  expiresAt   DateTime
  actionLog   Json              @default("[]") // Append-only JSON array of admin actions

  @@index([adminUserId])
  @@index([companyId])
  @@map("platform_support_accesses")
}

// ---------------------------------------------------------------------------
// 2. TENANT (Company)
// ---------------------------------------------------------------------------

model Company {
  id        String        @id @default(uuid())
  legalName String
  size      String? // PLG: e.g. "1-10", "11-50", etc.
  industry  String? // PLG: e.g. "IT", "HR", etc.
  status    CompanyStatus @default(Active)
  createdAt DateTime      @default(now())

  // Platform Relations
  subscriptions   Subscription[]
  supportAccesses PlatformSupportAccess[]

  // Tenant Relations
  users                User[]
  roles                Role[]
  branches             Branch[]
  processTemplates     ProcessTemplate[]
  complianceRules      ComplianceRule[]
  tasks                Task[]
  processInstances     ProcessInstance[]
  complianceViolations ComplianceViolation[]
  complianceCategories ComplianceCategory[]
  escalations          Escalation[]
  complianceEvidence   ComplianceEvidence[]

  updatedAt DateTime @updatedAt

  @@map("companies")
}

enum CompanyStatus {
  Active
  Suspended
  Closed
}

// ---------------------------------------------------------------------------
// 3. IDENTITY & ACCESS (Tenant Layer)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  fullName      String
  email         String
  jobTitle      String?   @map("roleTitle")
  passwordHash  String
  managerUserId String?
  manager       User?     @relation("ManagerReports", fields: [managerUserId], references: [id])
  reports       User[]    @relation("ManagerReports")
  tokenVersion  Int       @default(1)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedAt DateTime?

  roleAssignments           RoleAssignment[]      @relation("AssignmentUser")
  grantedAssignments        RoleAssignment[]      @relation("AssignmentGrantedBy")
  attachments               Attachment[]
  createdTasks              Task[]                @relation("TaskCreatedBy")
  assignedTasks             Task[]                @relation("TaskAssignedTo")
  reportedViolations        ComplianceViolation[] @relation("ViolationReportedBy")
  resolvedViolations        ComplianceViolation[] @relation("ViolationResolvedBy")
  stepsAssigned             ProcessInstanceStep[] @relation("StepAssignedTo")
  stepsActioned             ProcessInstanceStep[] @relation("StepActionedBy")
  escalationsReported       Escalation[]          @relation("EscalationReportedBy")
  escalationsTargeted       Escalation[]          @relation("EscalationTargetManager")
  evidenceSubmitted         ComplianceEvidence[]  @relation("EvidenceSubmittedBy")
  evidenceReviewed          ComplianceEvidence[]  @relation("EvidenceReviewedBy")
  ownedComplianceCategories ComplianceCategory[]  @relation("ComplianceCategoryOwner")
  notifications             Notification[]
  complianceAuditLogs       ComplianceAuditLog[]

  systemAuditLogsTargeted   SystemAuditLog[]  @relation("SystemAuditTargetUser")
  systemAuditLogsPerformed  SystemAuditLog[]  @relation("SystemPerformedBy")
  processAuditLogsPerformed ProcessAuditLog[] @relation("ProcessPerformedBy")

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model Permission {
  id          String @id @default(uuid())
  slug        String
  module      String
  description String

  roleTemplates RoleTemplatePermission[]
  roles         RolePermission[]

  @@map("permissions")
}

model RoleTemplate {
  id          String             @id @default(uuid())
  slug        String?
  origin      RoleTemplateOrigin @default(platform_predefined)
  label       String
  description String?

  defaultPermissions RoleTemplatePermission[]
  roles              Role[]

  updatedAt DateTime @updatedAt

  @@map("role_templates")
}

enum RoleTemplateOrigin {
  platform_predefined
  company_custom
}

model RoleTemplatePermission {
  roleTemplateId String
  roleTemplate   RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleTemplateId, permissionId])
  @@map("role_template_permissions")
}

model Role {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  roleTemplateId String?
  roleTemplate   RoleTemplate? @relation(fields: [roleTemplateId], references: [id])
  name           String?
  label          String
  description    String?
  isSystem       Boolean       @default(false)

  permissions     RolePermission[]
  roleAssignments RoleAssignment[]

  updatedAt DateTime @updatedAt

  systemAuditLogs SystemAuditLog[]

  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id            String    @id @default(uuid())
  companyId     String?
  userId        String
  user          User      @relation("AssignmentUser", fields: [userId], references: [id])
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  scopeType     ScopeType
  scopeId       String
  grantedById   String?
  grantedByUser User?     @relation("AssignmentGrantedBy", fields: [grantedById], references: [id])
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@map("role_assignments")
}

enum ScopeType {
  Company
  Branch
  Team
  Project
}

// ---------------------------------------------------------------------------
// 4. ORGANIZATION STRUCTURE
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]

  systemAuditLogs SystemAuditLog[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("branches")
}

model Team {
  id        String   @id @default(uuid())
  companyId String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    Project[]
  teamMembers TeamMember[]

  systemAuditLogs SystemAuditLog[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  companyId String
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String
  role      String?  @default("Member")
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// 5. PROJECT & TASK WORKFLOW
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid())
  companyId   String
  teamId      String
  team        Team          @relation(fields: [teamId], references: [id])
  name        String
  description String?
  status      ProjectStatus @default(Planning)
  startDate   DateTime?
  targetDate  DateTime?     @map("endDate")
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks            Task[]
  processInstances ProcessInstance[]
  escalations      Escalation[]

  createdById String

  processAuditLogs ProcessAuditLog[]

  @@index([teamId])
  @@map("projects")
}

enum ProjectStatus {
  Planning
  Active
  OnHold
  Completed
  Cancelled
}

model Task {
  id                    String       @id @default(uuid())
  companyId             String
  company               Company      @relation(fields: [companyId], references: [id])
  projectId             String?
  project               Project?     @relation(fields: [projectId], references: [id])
  processInstanceStepId String?
  title                 String
  description           String?
  status                TaskStatus   @default(Draft)
  priority              TaskPriority @default(Medium)
  assignedToId          String?
  assignedTo            User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById           String
  createdBy             User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dueDate               DateTime?
  completedAt           DateTime?
  estimatedHours        Decimal?
  actualHours           Decimal?     @default(0)
  deletedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  subtasks           Subtask[]
  escalations        Escalation[]
  complianceEvidence ComplianceEvidence[]

  processAuditLogs ProcessAuditLog[]

  @@index([companyId])
  @@index([projectId])
  @@index([assignedToId])
  @@map("tasks")
}

enum TaskStatus {
  Draft
  Active
  In_Review
  Blocked
  Completed
  Cancelled
}

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

model Subtask {
  id           String     @id @default(uuid())
  companyId    String
  taskId       String
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       TaskStatus @default(Draft)
  assignedToId String?
  createdById  String
  dueDate      DateTime?
  completedAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([taskId])
  @@map("subtasks")
}

// ---------------------------------------------------------------------------
// 6. PROCESS ENGINE (Templates, Instances, Steps)
// ---------------------------------------------------------------------------

model ProcessTemplate {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps     ProcessTemplateStep[]
  instances ProcessInstance[]

  processAuditLogs ProcessAuditLog[]

  @@unique([companyId, name, version])
  @@index([companyId])
  @@map("process_templates")
}

model ProcessTemplateStep {
  id                 String                @id @default(uuid())
  companyId          String?
  templateId         String
  template           ProcessTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepOrder          Int
  name               String
  stepType           StepType
  onRejectGotoStepId String?
  onRejectGotoStep   ProcessTemplateStep?  @relation("StepRejectionPath", fields: [onRejectGotoStepId], references: [id])
  rejectionTargets   ProcessTemplateStep[] @relation("StepRejectionPath")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  instanceSteps ProcessInstanceStep[]

  @@unique([templateId, stepOrder])
  @@index([templateId])
  @@map("process_template_steps")
}

enum StepType {
  Approval
  Input_Required
  Automated_Task
}

model ProcessInstance {
  id            String                @id @default(uuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id])
  templateId    String
  template      ProcessTemplate       @relation(fields: [templateId], references: [id])
  projectId     String?
  project       Project?              @relation(fields: [projectId], references: [id])
  currentStepId String?
  status        ProcessInstanceStatus @default(Draft)
  initiatedById String?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  steps ProcessInstanceStep[]

  title String

  @@index([companyId])
  @@index([templateId])
  @@index([projectId])
  @@map("process_instances")
}

enum ProcessInstanceStatus {
  Draft
  Active
  Completed
  Cancelled
  Rejected
}

model ProcessInstanceStep {
  id                String              @id @default(uuid())
  companyId         String?
  processInstanceId String
  processInstance   ProcessInstance     @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)
  templateStepId    String
  templateStep      ProcessTemplateStep @relation(fields: [templateStepId], references: [id])
  status            StepStatus          @default(Pending)
  assignedToId      String?
  assignedTo        User?               @relation("StepAssignedTo", fields: [assignedToId], references: [id])
  actionedById      String?
  actionedBy        User?               @relation("StepActionedBy", fields: [actionedById], references: [id])
  actionedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([processInstanceId])
  @@index([templateStepId])
  @@map("process_instance_steps")
}

enum StepStatus {
  Pending
  Approved
  Rejected
  Skipped
}

// ---------------------------------------------------------------------------
// 7. COMPLIANCE & ESCALATION ENGINE
// ---------------------------------------------------------------------------

model ComplianceCategory {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  description String?
  ownerId     String?
  owner       User?    @relation("ComplianceCategoryOwner", fields: [ownerId], references: [id])

  rules ComplianceRule[]

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("compliance_categories")
}

model ComplianceRule {
  id          String              @id @default(uuid())
  companyId   String?
  company     Company?            @relation(fields: [companyId], references: [id])
  name        String
  description String
  severity    Severity
  categoryId  String?
  category    ComplianceCategory? @relation(fields: [categoryId], references: [id])
  isActive    Boolean             @default(true)

  sourceTemplateId String?
  sourceTemplate   ComplianceRule?  @relation("ClonedFrom", fields: [sourceTemplateId], references: [id])
  clonedRules      ComplianceRule[] @relation("ClonedFrom")

  // The machine-readable evaluation criteria
  criteria         Json?    
  
  // E.g., "BLOCK_TRANSITION", "ALLOW_WITH_WARNING"
  actionOnFail     String           @default("BLOCK_TRANSITION") 

  bindings   ComplianceBinding[]
  violations ComplianceViolation[]

  updatedAt           DateTime             @updatedAt
  complianceAuditLogs ComplianceAuditLog[]

  @@index([companyId])
  @@index([categoryId])
  @@map("compliance_rules")
}

enum Severity {
  Low
  Medium
  High
  Critical
}

model ComplianceBinding {
  id        String         @id @default(uuid())
  ruleId    String
  rule      ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  scopeType ScopeType
  scopeId   String

  companyId String

  @@unique([ruleId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@map("compliance_bindings")
}

model ComplianceViolation {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  ruleId            String
  rule              ComplianceRule  @relation(fields: [ruleId], references: [id])
  entityType        String
  entityId          String
  status            ViolationStatus @default(Open)
  severity          Severity
  detectedAt        DateTime        @default(now())
  reportedById      String?
  reportedBy        User?           @relation("ViolationReportedBy", fields: [reportedById], references: [id])
  resolvedById      String?
  resolvedBy        User?           @relation("ViolationResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  resolutionRemarks String?
  dueDate           DateTime?

  evidence ComplianceEvidence[]

  updatedAt           DateTime             @updatedAt
  complianceAuditLogs ComplianceAuditLog[]

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([ruleId])
  @@map("compliance_violations")
}

enum ViolationStatus {
  Open
  Under_Review
  Resolved
  Ignored
}

model Escalation {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  taskId          String?
  task            Task?            @relation(fields: [taskId], references: [id])
  projectId       String?
  project         Project?         @relation(fields: [projectId], references: [id])
  reportedById    String
  reportedBy      User             @relation("EscalationReportedBy", fields: [reportedById], references: [id])
  targetManagerId String?
  targetManager   User?            @relation("EscalationTargetManager", fields: [targetManagerId], references: [id])
  title           String
  description     String?
  blockerType     String?
  priority        Severity         @default(High)
  status          EscalationStatus @default(Open)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?

  @@index([companyId])
  @@index([taskId])
  @@map("escalations")
}

enum EscalationStatus {
  Open
  Reviewed
  Resolved
  Closed
}

model ComplianceEvidence {
  id           String               @id @default(uuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  userId       String
  user         User                 @relation("EvidenceSubmittedBy", fields: [userId], references: [id])
  taskId       String?
  task         Task?                @relation(fields: [taskId], references: [id])
  violationId  String?
  violation    ComplianceViolation? @relation(fields: [violationId], references: [id])
  title        String
  evidenceType String?
  fileUrl      String
  notes        String?
  status       EvidenceStatus       @default(Pending)
  reviewedById String?
  reviewedBy   User?                @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id])
  submittedAt  DateTime             @default(now())
  reviewedAt   DateTime?

  updatedAt           DateTime             @updatedAt
  complianceAuditLogs ComplianceAuditLog[]

  @@index([companyId])
  @@index([taskId])
  @@index([violationId])
  @@map("compliance_evidence")
}

enum EvidenceStatus {
  Pending
  Under_Review
  Approved
  Rejected
}

// ---------------------------------------------------------------------------
// 8. CROSS-CUTTING SERVICES
// ---------------------------------------------------------------------------

model Attachment {
  id            String   @id @default(uuid())
  companyId     String
  entityType    String   @map("resourceType")
  entityId      String   @map("resourceId")
  fileName      String   @map("originalName")
  fileType      String   @map("mimeType")
  fileSizeBytes Int      @map("sizeBytes")
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime @default(now()) @map("createdAt")

  storageKey String
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("file_objects")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  PERMISSION_CHANGE
  LOGOUT
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  ROLE_ASSIGNED
  ROLE_REVOKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SUPPORT_ACCESS_GRANTED
  SUPPORT_ACCESS_REVOKED
  EVIDENCE_APPROVED
  EVIDENCE_REJECTED
  VIOLATION_RESOLVED
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String    @map("body")
  type      String    @default("System")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  companyId String

  @@index([userId])
  @@map("notifications")
}

model ComplianceAuditLog {
  id        String @id @default(uuid())
  companyId String

  ruleId String?
  rule   ComplianceRule? @relation(fields: [ruleId], references: [id])

  violationId String?
  violation   ComplianceViolation? @relation(fields: [violationId], references: [id])

  evidenceId String?
  evidence   ComplianceEvidence? @relation(fields: [evidenceId], references: [id])

  action        AuditAction
  performedById String?
  performedBy   User?       @relation(fields: [performedById], references: [id])
  performedAt   DateTime    @default(now())

  oldValue Json?
  newValue Json?

  @@index([companyId])
  @@index([ruleId])
  @@index([violationId])
  @@index([evidenceId])
}

model SystemAuditLog {
  id        String @id @default(uuid())
  companyId String

  targetUserId String?
  targetUser   User?   @relation("SystemAuditTargetUser", fields: [targetUserId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  action        AuditAction
  performedById String?
  performedBy   User?       @relation("SystemPerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime    @default(now())

  ipAddress String?
  userAgent String?

  oldValue Json?
  newValue Json?

  @@index([companyId])
  @@index([targetUserId])
}

model ProcessAuditLog {
  id        String @id @default(uuid())
  companyId String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  templateId String?
  template   ProcessTemplate? @relation(fields: [templateId], references: [id])

  action        AuditAction
  performedById String?
  performedBy   User?       @relation("ProcessPerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime    @default(now())

  oldValue Json?
  newValue Json?

  @@index([companyId])
  @@index([projectId])
  @@index([taskId])
}
