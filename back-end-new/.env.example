# Server Configuration
PORT=5500
NODE_ENV=development

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://username:password@localhost:5432/optiflow?schema=public"

# JWT Secret Configuration (Mandatory: Must be set in production)
JWT_SECRET="replace_with_a_secure_random_secret_string"
JWT_EXPIRES_IN="24h"

# Allowed CORS Origins (comma-separated list for multiple origins)
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:64064"

# Rate Limiting Configuration
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Reverse Proxy Configuration
TRUST_PROXY=false
