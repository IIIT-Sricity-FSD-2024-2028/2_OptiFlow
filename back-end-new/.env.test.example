# Test Environment Configuration
NODE_ENV=test
PORT=5599

# Test Database Configuration - MUST contain 'test' in the database name
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/optiflow_test?schema=public"

# Test JWT Secrets
JWT_SECRET="test_super_secret_jwt_key_at_least_32_characters_long"
JWT_EXPIRES_IN="1h"
PLATFORM_JWT_EXPIRES_IN="1h"

# CORS and Rate Limiting
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=100
TRUST_PROXY=false
